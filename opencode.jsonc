{
  "$schema": "https://opencode.ai/config.json",
    // MCP (Model Context Protocol) 服务器配置
    "mcp": {
        // Dart 语言的 MCP 服务器（由 Dart SDK 提供）
        "dart-mcp-server": {
          "type": "local",
          "command": ["dart", "mcp-server"],
          "enabled": true,
          "environment": {}
        },
    }
}
